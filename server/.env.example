MONGODB_URI=mongodb://127.0.0.1:27017/getprrety
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=https://your-web-app.example.com
CONSENT_VERSION=replace-with-published-policy-version
# Comma-separated list of every Google OAuth client ID this API should accept ID tokens from
# (the web, iOS, and Android client IDs from Google Cloud Console — id_token "aud" varies by platform).
GOOGLE_CLIENT_IDS=replace-with-comma-separated-google-oauth-client-ids
ANTHROPIC_API_KEY=replace-with-server-only-key
ANTHROPIC_MODEL=replace-with-supported-model-id
# Public origin of the deployed app, used for links in the clinic notification email.
PUBLIC_BASE_URL=https://getpretty.app

# ── Clinic notification email (Postmark) ──
# Server API Token from the Postmark server that owns the verified sender signature/domain.
POSTMARK_API_KEY=replace-with-postmark-server-api-token
# Must be a Postmark-verified sender signature or a verified-domain address.
POSTMARK_SENDER_ADDRESS=hello@getpretty.app
# Optional: Postmark message stream id (default: outbound)
POSTMARK_MESSAGE_STREAM=outbound
# Optional: comma-separated recipients for the clinic summary email
# (default: lutreat@gmail.com,dzaturansky@gmail.com)
CLINIC_NOTIFY_TO=lutreat@gmail.com,dzaturansky@gmail.com

# ── Admin dashboard (/admin) ──
# Comma-separated Google account emails allowed to sign into the dashboard.
ADMIN_ALLOWED_EMAILS=dzaturansky@gmail.com,lutreat@gmail.com
# Google OAuth client ID the sign-in button uses. Defaults to the first entry of
# GOOGLE_CLIENT_IDS if unset.
ADMIN_GOOGLE_CLIENT_ID=replace-with-google-oauth-web-client-id
# Optional: separate secret for signing the admin session cookie (defaults to JWT_SECRET).
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
PERFECTCORP_API_KEY=replace-with-server-only-key
PERFECTCORP_BASE_URL=https://yce-api-01.makeupar.com/s2s/v2.0
PERFECTCORP_DST_ACTIONS=acne,pore,texture,redness,oiliness,moisture,radiance,wrinkle,firmness,age_spot,skin_type
# Railway analysis service. When set, the server asks its /score-reading endpoint for the
# Profile score-section copy once per complete scan. Unset -> the section shows numbers only.
# Set it only once /score-reading is deployed on Railway: a failed request is final per scan.
# RAILWAY_API_URL=https://getpretty-api-production.up.railway.app
SIDE_PHOTO_ANALYSIS_ENABLED=true
SKIN_ANALYSIS_POLL_INTERVAL_MS=2000
SKIN_ANALYSIS_MAX_POLL_MS=90000
SKIN_SCAN_PER_IP_HOURLY_LIMIT=3
SKIN_SCAN_GLOBAL_HOURLY_LIMIT=100
AI_REQUESTS_PER_USER_HOUR=10

# Per-IP throttle for the unauthenticated auth endpoints (defaults shown). Login and
# Google refund a successful attempt, so those two ceilings cap failures and bursts,
# not real logins — both require a valid credential to succeed, so a refund can't be
# driven by an attacker. Signup does NOT refund: it needs no credential, so refunding
# completed signups would make the bucket track only failures, turning the per-IP cap
# into unbounded account creation. Raise the signup limit instead if a clinic puts many
# clients through one shared address.
AUTH_LOGIN_IP_15MIN_LIMIT=15
AUTH_SIGNUP_IP_HOURLY_LIMIT=30
AUTH_GOOGLE_IP_15MIN_LIMIT=30

# In-app booking (consultations). Booking is OFF unless ALL three are set; the server log
# prints one line at start-up saying whether it is on and which setting is missing.
# Turns booking on: set to 1.
BOOKING_ENABLED=
# Id of the clinic Google Calendar (Calendar settings > "Integrate calendar" > Calendar ID).
# The calendar must be shared with the service-account email with "Make changes to events".
GOOGLE_CALENDAR_ID=
# The service-account key JSON file, base64-encoded (one line). A secret: never commit a real value.
GOOGLE_SERVICE_ACCOUNT_JSON_B64=
