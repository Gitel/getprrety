<%# Move / remove buttons for one editor row. Behaviour lives in _editor.ejs. %>
<div class="row-tools">
  <button type="button" class="btn secondary small" data-row-action="up" title="Move up">&uarr;</button>
  <button type="button" class="btn secondary small" data-row-action="down" title="Move down">&darr;</button>
  <button type="button" class="small danger" data-row-action="remove">Remove</button>
</div>
