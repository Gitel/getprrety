<%#
  Bookings list, one tab at a time. Rows come from bookings.listForAdmin; `date`/`time` are
  already clinic-local (Asia/Jerusalem). Only the Upcoming tab offers Cancel
  (confirmed rows and awaiting-payment holds).
%>
<%- include('_head', { title: 'Bookings' }) %>
<%- include('_nav', { active: 'bookings' }) %>
<main>
  <% if (locals.notice) { %>
    <div class="notice <%= notice.error ? 'error' : '' %>"><%= notice.text %></div>
  <% } %>

  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px;">
    <h1 style="font-size: 20px; margin: 0;">Bookings</h1>
    <a href="/admin/booking-settings" class="btn secondary">Booking settings</a>
  </div>

  <nav class="tabs sections" style="margin-bottom: 14px;">
    <a href="/admin/bookings?tab=upcoming" class="<%= tab === 'upcoming' ? 'active' : '' %>">Upcoming</a>
    <a href="/admin/bookings?tab=past" class="<%= tab === 'past' ? 'active' : '' %>">Past</a>
    <a href="/admin/bookings?tab=cancelled" class="<%= tab === 'cancelled' ? 'active' : '' %>">Cancelled</a>
    <a href="/admin/bookings?tab=attention" class="<%= tab === 'attention' ? 'active' : '' %>">Needs attention</a>
  </nav>

  <% if (!rows.length) { %>
    <p class="muted">No bookings.</p>
  <% } else { %>
    <table>
      <thead>
        <tr><th>When</th><th>Client</th><th>Note</th><th>Status</th><th>Payment</th><th>Attention</th><% if (tab === 'upcoming') { %><th></th><% } %></tr>
      </thead>
      <tbody>
        <% rows.forEach(function (b) { %>
          <tr data-booking-id="<%= b.id %>">
            <td class="when"><%= b.date %> <%= b.time %></td>
            <td><a href="/admin/users/<%= b.userId %>"><%= b.userEmail %></a></td>
            <td><%= b.note %></td>
            <td class="status"><%- include('_bookingStatus', { b: b }) %></td>
            <%# Payment recorded by the Shopify webhook; "-" while nothing was paid. %>
            <td class="payment"><% if (b.payment && b.payment.status === 'paid') { %>Paid <%= b.payment.amount %> <%= b.payment.currency %> - order <%= b.payment.providerRef %><% } else { %>-<% } %></td>
            <%# A payment that could not be matched to a normal booking: a human must act. %>
            <td class="attention"><%= { paid_slot_lost: 'Paid, slot lost', paid_after_cancel: 'Paid after cancel', paid_extra: 'Extra payment' }[b.needsAttention] || '' %></td>
            <% if (tab === 'upcoming') { %>
              <td>
                <%# data-confirm: the shared script in _foot asks before submitting. %>
                <form class="inline-form" method="post" action="/admin/bookings/<%= b.id %>/cancel"
                      data-confirm="Cancel this booking and remove it from the calendar? If it was paid, refund it in Shopify.">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="small danger">Cancel booking</button>
                </form>
              </td>
            <% } %>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>
</main>
<%- include('_foot') %>
