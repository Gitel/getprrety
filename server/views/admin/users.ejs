<%#
  Users list: one row per account (the Clients page is one row per quiz completion).
  Includes people who signed up but never finished the quiz. Data from userDirectory.listUsers.
%>
<%
  function stamp(d) { return d ? new Date(d).toISOString().slice(0, 16).replace('T', ' ') : '—'; }
  // Builds a page link that keeps the current search term.
  function pageHref(p) { return '/admin/users?page=' + p + (list.q ? '&q=' + encodeURIComponent(list.q) : ''); }
%>
<%- include('_head', { title: 'Users' }) %>
<%- include('_nav', { active: 'users' }) %>
<main>
  <% if (locals.notice) { %>
    <div class="notice <%= notice.error ? 'error' : '' %>"><%= notice.text %></div>
  <% } %>
  <%# Invite a person who has no account yet (POST /admin/invites). The link they get creates
      the account the first time they open it. %>
  <section class="card" id="invite">
    <h2>Invite a new customer</h2>
    <form method="post" action="/admin/invites">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label for="invite-email">Email</label>
      <input type="email" id="invite-email" name="email" required maxlength="254">
      <label for="invite-first-name">First name</label>
      <input type="text" id="invite-first-name" name="firstName" maxlength="100">
      <label for="invite-language">Language</label>
      <select id="invite-language" name="language">
        <option value="he" selected>Hebrew</option>
        <option value="en">English</option>
      </select>
      <p><button type="submit">Send invite</button></p>
    </form>
  </section>

  <%# Invites nobody has opened yet and that are still valid. %>
  <section class="card" id="invites">
    <h2>Pending invites</h2>
    <% var pendingInvites = locals.invites || []; %>
    <% if (!pendingInvites.length) { %>
      <p class="muted">No pending invites.</p>
    <% } else { %>
      <table>
        <thead><tr><th>Email</th><th>First name</th><th>Valid</th><th>Link</th><th></th></tr></thead>
        <tbody>
          <% pendingInvites.forEach(function (inv) { %>
            <tr data-invite-id="<%= inv.id %>">
              <td><%= inv.invite && inv.invite.email %></td>
              <td><%= (inv.invite && inv.invite.firstName) || '—' %></td>
              <td>Active until <%= stamp(inv.expiresAt) %></td>
              <td>
                <input type="text" id="invite-url-<%= inv.id %>" readonly value="<%= inv.link || '' %>">
                <button type="button" class="small secondary" data-copy="#invite-url-<%= inv.id %>" aria-label="Copy link">Copy link</button>
              </td>
              <td>
                <form class="inline-form" method="post" action="/admin/invites/<%= inv.id %>/resend">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="small secondary">Resend email</button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>
  </section>

  <form method="get" action="/admin/users" style="display: flex; gap: 8px; margin-bottom: 14px;">
    <input type="search" name="q" value="<%= list.q %>" maxlength="100" placeholder="Search by email or first name">
    <button type="submit">Search</button>
  </form>

  <p class="muted"><%= list.total %> user<%= list.total === 1 ? '' : 's' %><%= list.q ? ' matching "' + list.q + '"' : '' %></p>

  <table>
    <thead>
      <tr><th>Name</th><th>Email</th><th>Signed up</th><th>Sign-in</th><th>Quiz completions</th><th>Latest Skin Era</th></tr>
    </thead>
    <tbody>
      <% list.users.forEach(function (u) { %>
        <tr>
          <td><a href="/admin/users/<%= u._id %>"><%= u.firstName || '(no name)' %></a></td>
          <td><%= u.email %></td>
          <td><%= stamp(u.createdAt) %></td>
          <td><%= u.googleId ? 'Google' : 'Email' %></td>
          <td><%= u.analyses.count %></td>
          <td><%= u.analyses.latestEraName || u.analyses.latestEraId || '—' %></td>
        </tr>
      <% }); %>
      <% if (!list.users.length) { %>
        <tr><td colspan="6" class="muted">No users found.</td></tr>
      <% } %>
    </tbody>
  </table>

  <% if (list.pages > 1) { %>
    <p style="margin-top: 14px;">
      <% if (list.page > 1) { %><a href="<%= pageHref(list.page - 1) %>">&larr; Newer</a> &nbsp;<% } %>
      Page <%= list.page %> of <%= list.pages %>
      <% if (list.page < list.pages) { %>&nbsp; <a href="<%= pageHref(list.page + 1) %>">Older &rarr;</a><% } %>
    </p>
  <% } %>
</main>
<%- include('_foot') %>
